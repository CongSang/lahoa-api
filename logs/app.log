        sum(cast(coalesce(mie1_0.on_hand, 0) as signed)),
        sum(cast(coalesce(mie1_0.reserved, 0) as signed)),
        sum(cast((coalesce(mie1_0.on_hand, 0)-coalesce(mie1_0.reserved, 0)) as signed)),
        cast(coalesce(me1_0.low_stock_threshold, 0) as signed),
        case 
            when sum(case 
                when mie1_0.on_hand<=me1_0.low_stock_threshold 
                and mie1_0.on_hand>0 
                    then 1 
                else 0 
        end)>0 
            then 1 
        else 0 
end,
case 
    when sum(case 
        when mie1_0.on_hand=0 
            then 1 
        else 0 
end)>0 
    then 1 
else 0 
end,
case 
    when sum(coalesce(mie1_0.on_hand, 0))>0 
        then (sum((cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20))*cast(coalesce(mie1_0.cost_price, 0) as decimal(53, 20))))/sum(cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20)))) 
    else 0 
end 
from
    materials me1_0 
join
    material_categories c1_0 
        on c1_0.id=me1_0.category_id 
left join
    material_inventories mie1_0 
        on mie1_0.material_id=me1_0.id 
where
    (
        ? is null 
        or lower(me1_0.name) like lower(concat('%', ?, '%')) escape '' 
        or lower(me1_0.code) like lower(concat('%', ?, '%')) escape ''
    ) 
    and (
        ? is null 
        or c1_0.id=?
    ) 
    and (
        (
            ? is null 
            and me1_0.status<>'DELETED'
        ) 
        or (
            ? is not null 
            and me1_0.status=?
        )
    ) 
    and (
        ? is null 
        or mie1_0.warehouse_id=?
    ) 
group by
    me1_0.id,
    c1_0.id,
    c1_0.name,
    me1_0.code,
    me1_0.name,
    me1_0.unit,
    me1_0.thumbnail,
    me1_0.thumbnail_public_id,
    me1_0.status 
having
    (
        ? is null 
        or ?=0 
        or sum(case 
            when mie1_0.on_hand<=me1_0.low_stock_threshold 
            and mie1_0.on_hand>0 
                then 1 
            else 0 
    end)>0
) 
and (
    ? is null 
    or ?=0 
    or sum(case 
        when mie1_0.on_hand=0 
            then 1 
        else 0 
end)>0
) 
order by
    me1_0.id desc 
limit
    ?
