        then (sum((cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20))*cast(coalesce(mie1_0.cost_price, 0) as decimal(53, 20))))/sum(cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20)))) 
    else 0 
end 
from
