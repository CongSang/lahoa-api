    ) 
    and (
        ? is null 
        or c1_0.id=?
    ) 
    and (
        (
            ? is null 
            and me1_0.status<>'DELETED'
        ) 
        or (
            ? is not null 
            and me1_0.status=?
        )
    ) 
    and (
        ? is null 
        or mie1_0.warehouse_id=?
    ) 
group by
    me1_0.id,
    c1_0.id,
    c1_0.name,
    me1_0.code,
    me1_0.name,
    me1_0.unit,
    me1_0.thumbnail,
    me1_0.thumbnail_public_id,
    me1_0.status 
having
    (
        ? is null 
        or ?=0 
        or sum(case 
            when mie1_0.on_hand<=me1_0.low_stock_threshold 
            and mie1_0.on_hand>0 
                then 1 
            else 0 
    end)>0
) 
and (
    ? is null 
    or ?=0 
    or sum(case 
        when mie1_0.on_hand=0 
