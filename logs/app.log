        on mie1_0.material_id=me1_0.id 
where
    (
        ? is null 
        or lower(me1_0.name) like lower(concat('%', ?, '%')) escape '' 
        or lower(me1_0.code) like lower(concat('%', ?, '%')) escape ''
    ) 
    and (
        ? is null 
        or c1_0.id=?
    ) 
    and (
        (
            ? is null 
            and me1_0.status<>'DELETED'
        ) 
        or (
            ? is not null 
            and me1_0.status=?
        )
    ) 
    and (
        ? is null 
        or mie1_0.warehouse_id=?
    ) 
group by
