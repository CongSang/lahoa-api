        sum(cast(coalesce(mie1_0.on_hand, 0) as signed)),
        sum(cast(coalesce(mie1_0.reserved, 0) as signed)),
        sum(cast((coalesce(mie1_0.on_hand, 0)-coalesce(mie1_0.reserved, 0)) as signed)),
        cast(coalesce(me1_0.low_stock_threshold, 0) as signed),
        case 
            when sum(case 
                when mie1_0.on_hand<=me1_0.low_stock_threshold 
                and mie1_0.on_hand>0 
                    then 1 
                else 0 
        end)>0 
            then 1 
        else 0 
end,
case 
    when sum(case 
        when mie1_0.on_hand=0 
            then 1 
        else 0 
end)>0 
    then 1 
else 0 
end,
case 
    when sum(coalesce(mie1_0.on_hand, 0))>0 
        then (sum((cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20))*cast(coalesce(mie1_0.cost_price, 0) as decimal(53, 20))))/sum(cast(coalesce(mie1_0.on_hand, 0) as decimal(53, 20)))) 
    else 0 
end 
from
    materials me1_0 
join
    material_categories c1_0 
        on c1_0.id=me1_0.category_id 
left join
